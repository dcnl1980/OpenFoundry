# ══════════════════════════════════════════════════════════════
# OpenFoundry — Environment Configuration
# Copy this file: cp .env.example .env
# ══════════════════════════════════════════════════════════════

# ── General ──────────────────────────────────────────────────
# production | prod refuses the default JWT secret and plaintext HTTP.
ENVIRONMENT=development
LOG_LEVEL=debug
RUST_LOG=info,open_foundry=debug

# ── Gateway ──────────────────────────────────────────────────
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# ── Database (PostgreSQL) ────────────────────────────────────
# Each service needs its own database. Sharing one database collides on _sqlx_migrations.
# Runtime role must be NOSUPERUSER NOBYPASSRLS or FORCE ROW LEVEL SECURITY is skipped.
# Example for auth-service; swap the database name per process:
#   openfoundry_auth, openfoundry_connector, openfoundry_dataset, openfoundry_streaming,
#   openfoundry_query, openfoundry_pipeline, openfoundry_ontology, openfoundry_fusion,
#   openfoundry_ml, openfoundry_ai, openfoundry_workflow, openfoundry_notebook,
#   openfoundry_apps, openfoundry_report, openfoundry_code, openfoundry_market,
#   openfoundry_nexus, openfoundry_geo, openfoundry_notify, openfoundry_audit
DATABASE_URL=postgres://openfoundry_app:openfoundry@localhost:5432/openfoundry_auth
MIGRATION_DATABASE_URL=postgres://openfoundry:openfoundry@localhost:5432/openfoundry_auth
DATABASE_MAX_CONNECTIONS=20

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# Trust X-Forwarded-For / X-Real-IP only when a trusted proxy sets them.
TRUST_FORWARDED_HEADERS=false
# Unauthenticated and login traffic. Authenticated callers use the tenant quota.
ANONYMOUS_REQUESTS_PER_MINUTE=60

# ── NATS (Messaging) ────────────────────────────────────────
NATS_URL=nats://localhost:4222

# ── Object Storage (MinIO / S3) ─────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=openfoundry
S3_REGION=us-east-1

# ── Search (Meilisearch) ────────────────────────────────────
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=masterKey

# ── Vector DB (Qdrant) ──────────────────────────────────────
QDRANT_URL=http://localhost:6334

# ── Service mTLS (required in production) ───────────────────
# Generate local material with: ./scripts/gen-mtls-certs.sh ./certs
# Services use the server cert; the gateway uses the client cert.
# TLS_CERT_PATH=./certs/server.pem
# TLS_KEY_PATH=./certs/server.key
# TLS_CA_PATH=./certs/ca.pem

# ── Auth / JWT ───────────────────────────────────────────────
# Production requires a unique secret of at least 32 characters.
JWT_SECRET=change-me-in-production-use-a-256-bit-key
JWT_EXPIRATION_SECONDS=3600
JWT_REFRESH_EXPIRATION_SECONDS=604800
# Optional. This email is granted admin on register or next login.
# BOOTSTRAP_ADMIN_EMAIL=ops@example.com

# ── AI / LLM (optional) ─────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-v1-...
# ANTHROPIC_API_KEY=sk-ant-...
# OLLAMA_URL=http://localhost:11434

# ── Observability (optional) ─────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# JAEGER_ENDPOINT=http://localhost:14268/api/traces